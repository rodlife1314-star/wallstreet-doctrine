{
  "entities": {
    "custody_packet": {
      "title": "CustodyPacket",
      "description": "Represents the active intelligence packet flowing through the cockpit pipeline.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique packet identifier"
        },
        "challenge": {
          "type": "string",
          "description": "The specific economic / analytical question"
        },
        "authorities": {
          "type": "array",
          "description": "Credible sources like FRED, BLS"
        },
        "recommendations": {
          "type": "array",
          "description": "Target codes recommended by Pathfinder"
        },
        "confidence": {
          "type": "number",
          "description": "Pathfinder confidence estimate"
        },
        "jemmaVerdict": {
          "type": "string",
          "description": "Validation review outcome from Jemma"
        },
        "redTeamVerdict": {
          "type": "string",
          "description": "Validation review outcome from the Red Team"
        },
        "operatorApproved": {
          "type": "boolean",
          "description": "Operator approval status"
        },
        "deployable": {
          "type": "boolean",
          "description": "Deploy readiness flag"
        },
        "status": {
          "type": "string",
          "description": "Packet position on taxonomy status ladder"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "history": {
          "type": "array",
          "description": "Historical log of state transitions and actor decisions"
        }
      },
      "required": [
        "id",
        "challenge",
        "status"
      ]
    },
    "dataset_candidate": {
      "title": "DatasetCandidate",
      "description": "A URL metadata candidate linked to a custody packet",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "packetId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "datasetId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "packetId",
        "url"
      ]
    },
    "validation_review": {
      "title": "ValidationReview",
      "description": "Reviews attached by validation engines",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "packetId": {
          "type": "string"
        },
        "reviewType": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "packetId",
        "reviewType",
        "verdict"
      ]
    },
    "operator_approval": {
      "title": "OperatorApproval",
      "description": "The operator digital seal records",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "packetId": {
          "type": "string"
        },
        "operatorId": {
          "type": "string"
        },
        "sealStatus": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "packetId",
        "sealStatus"
      ]
    },
    "doctrine_authority": {
      "title": "DoctrineAuthority",
      "description": "Represents a federally tracked authority class inside the Pathfinder governance doctrine.",
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "description": "Short code name of the authority"
        },
        "category": {
          "type": "string",
          "description": "Classification category under the economic structure"
        },
        "status": {
          "type": "string",
          "description": "Observation policy status"
        },
        "role": {
          "type": "string",
          "description": "The specific economic/analytical role"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of tracking indices or options metrics"
        }
      },
      "required": [
        "authority",
        "category",
        "status"
      ]
    },
    "copilot_message": {
      "title": "CopilotMessage",
      "description": "A live, persistent message inside the cockpit co-navigator chat interface.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "sender",
        "text",
        "timestamp",
        "createdAt"
      ]
    },
    "cme_credential": {
      "title": "CmeCredential",
      "description": "Securely registered CME SSO Username and password on the ledger",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "username",
        "password"
      ]
    },
    "asset_profile": {
      "title": "AssetProfile",
      "description": "Asset-specific behavior rules, preferences, and dynamic probability weights.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preferredSessions": {
          "type": "array"
        },
        "failedSetupsCount": {
          "type": "number"
        },
        "successfulConfluencesCount": {
          "type": "number"
        },
        "diNapoliFibResponseWeight": {
          "type": "number"
        },
        "macroDrivers": {
          "type": "array"
        },
        "liquidityHabits": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "custody_timeframe_state": {
      "title": "CustodyTimeframeState",
      "description": "Hierarchical timeframe states representing the D1 -> H4 -> M15 -> M5 sequence.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "assetId": {
          "type": "string"
        },
        "timeframe": {
          "type": "string",
          "enum": ["D1", "H4", "M15", "M5"]
        },
        "role": {
          "type": "string"
        },
        "authorityWeight": {
          "type": "number"
        },
        "currentFinding": {
          "type": "string"
        },
        "invalidationLine": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "assetId",
        "timeframe"
      ]
    },
    "pattern_registry_entry": {
      "title": "PatternRegistryEntry",
      "description": "Cross-asset execution and behavioral tracking patterns in the lattice.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "enum": ["X-Break Redistribution", "ABCD Paddle", "382 Trap", "618 Continuation", "Order Block Mitigation", "Vector Candle Trap"]
        },
        "asset": {
          "type": "string"
        },
        "timeframe": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "entryCondition": {
          "type": "string"
        },
        "invalidation": {
          "type": "number"
        },
        "target": {
          "type": "number"
        },
        "outcome": {
          "type": "string",
          "enum": ["SUCCESS", "FAILURE"]
        },
        "lesson": {
          "type": "string"
        },
        "probabilityWeight": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "asset",
        "outcome"
      ]
    },
    "macro_context_snapshot": {
      "title": "MacroContextSnapshot",
      "description": "Global macroeconomic conditions backdrop snapshots.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "yieldCurveStatus": {
          "type": "string"
        },
        "dxyTrend": {
          "type": "string"
        },
        "vixValue": {
          "type": "number"
        },
        "fedPolicyBias": {
          "type": "string"
        },
        "newsEventImpact": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "timestamp"
      ]
    },
    "outcome_feedback_item": {
      "title": "OutcomeFeedbackItem",
      "description": "Feedback loops storing prediction vs actual outputs to prevent cognitive drift.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "patternId": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "predictedBias": {
          "type": "string"
        },
        "actualOutcome": {
          "type": "string"
        },
        "deviation": {
          "type": "number"
        },
        "weightAdjustmentApplied": {
          "type": "number"
        },
        "unsolicitedNotes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "patternId",
        "asset",
        "actualOutcome"
      ]
    },
    "operator_override": {
      "title": "OperatorOverride",
      "description": "Sovereign manual override ledger signed inside the WallStreet cockpit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "timeframe": {
          "type": "string"
        },
        "overrideReason": {
          "type": "string"
        },
        "approvedByOperator": {
          "type": "boolean"
        },
        "sealSignature": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "asset",
        "approvedByOperator"
      ]
    },
    "market_snapshot": {
      "title": "MarketSnapshot",
      "description": "A structural market-state telemetry snapshot ingested on the WallStreet switch-on port.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "price": {
          "type": "object"
        },
        "rates": {
          "type": "object"
        },
        "dollar": {
          "type": "object"
        },
        "volatility": {
          "type": "object"
        },
        "openInterest": {
          "type": "object"
        },
        "macro": {
          "type": "object"
        },
        "sourceConfidence": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "asset",
        "timestamp",
        "price",
        "rates",
        "dollar",
        "volatility",
        "openInterest",
        "macro",
        "sourceConfidence"
      ]
    }
  },
  "firestore": {
    "custody_packets/{packetId}": {
      "schema": "custody_packet",
      "description": "Ledger of intelligence custody packets"
    },
    "dataset_candidates/{candidateId}": {
      "schema": "dataset_candidate",
      "description": "Registered dataset URLs and parameters"
    },
    "validation_reviews/{reviewId}": {
      "schema": "validation_review",
      "description": "Double secure review reports from validating processes"
    },
    "operator_approvals/{approvalId}": {
      "schema": "operator_approval",
      "description": "Ledger of operator seal approvals"
    },
    "authority_doctrine/{authorityId}": {
      "schema": "doctrine_authority",
      "description": "Registry of credentialed economic data authorities inside the Pathfinder governance doctrine"
    },
    "copilot_messages/{messageId}": {
      "schema": "copilot_message",
      "description": "Live, persistent dialogue log of active co-pilot interactions"
    },
    "cme_credentials/{credentialId}": {
      "schema": "cme_credential",
      "description": "Securely registered federated CME Group credentials"
    },
    "asset_profiles/{assetId}": {
      "schema": "asset_profile",
      "description": "Lattice profile parameters for specific instruments."
    },
    "custody_timeframe_states/{stateId}": {
      "schema": "custody_timeframe_state",
      "description": "Timeframe state blocks representing hierarchies of influence."
    },
    "pattern_registry/{entryId}": {
      "schema": "pattern_registry_entry",
      "description": "Dynamic registered behavior and trading patterns across assets."
    },
    "macro_context_snapshots/{snapshotId}": {
      "schema": "macro_context_snapshot",
      "description": "Contextual macro overlays mapped contextually."
    },
    "outcome_feedback/{feedbackId}": {
      "schema": "outcome_feedback_item",
      "description": "Lattice tracking parameters adjusting probabilistics automatically."
    },
    "operator_overrides/{overrideId}": {
      "schema": "operator_override",
      "description": "Sovereign signature tracking override data on the ledger"
    },
    "market_snapshots/{snapshotId}": {
      "schema": "market_snapshot",
      "description": "Structured market state telemetry snapshots logged on the switch-on port"
    }
  }
}
