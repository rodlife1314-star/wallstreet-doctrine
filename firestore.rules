rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // Stand-alone validation helpers (Eight Pillars)
    function isValidPacket(p) {
      return p.packet_id is string && p.packet_id.size() <= 128
        && p.source_agent is string && p.source_agent.size() <= 256
        && p.challenge is string && p.challenge.size() <= 4096
        && p.dataset_recommendations is list
        && p.authority_chain is list
        && p.jemma_verdict is string && p.jemma_verdict.size() <= 64
        && p.red_team_verdict is string && p.red_team_verdict.size() <= 64
        && p.operator_gate is string && p.operator_gate.size() <= 64
        && p.current_status is string && p.current_status.size() <= 128
        && p.next_allowed_action is string && p.next_allowed_action.size() <= 256
        && p.get('confidence', 0) is number
        && p.dataset_recommendations.size() <= 50
        && (p.dataset_recommendations.size() == 0 || p.dataset_recommendations[0] is string)
        && p.authority_chain.size() <= 50
        && (p.authority_chain.size() == 0 || p.authority_chain[0] is string)
        && p.get('history', []) is list
        && p.get('history', []).size() <= 100
        && (p.get('history', []).size() == 0 || (
             p.get('history', [])[0].event_id is string &&
             p.get('history', [])[0].timestamp is string &&
             p.get('history', [])[0].old_status is string &&
             p.get('history', [])[0].new_status is string &&
             p.get('history', [])[0].actor is string
           ));
    }

    function isValidCandidate(c) {
      return c.id is string && c.id.size() <= 128
        && c.packetId is string && c.packetId.size() <= 128
        && c.url is string && c.url.size() <= 2048
        && c.status is string && c.status.size() <= 128
        && c.createdAt is string && c.createdAt.size() <= 128
        && (c.get('datasetId', '') is string && c.get('datasetId', '').size() <= 128)
        && (c.get('name', '') is string && c.get('name', '').size() <= 256);
    }

    function isValidReview(r) {
      return r.id is string && r.id.size() <= 128
        && r.packetId is string && r.packetId.size() <= 128
        && r.reviewType is string && r.reviewType.size() <= 64
        && r.verdict is string && r.verdict.size() <= 64
        && r.reason is string && r.reason.size() <= 4096
        && r.reviewer is string && r.reviewer.size() <= 128
        && r.createdAt is string && r.createdAt.size() <= 128;
    }

    function isValidApproval(a) {
      return a.id is string && a.id.size() <= 128
        && a.packetId is string && a.packetId.size() <= 128
        && a.operatorId is string && a.operatorId.size() <= 128
        && a.sealStatus is string && a.sealStatus.size() <= 64
        && a.timestamp is string && a.timestamp.size() <= 128;
    }

    // Blueprint for economic credential authority class in the Pathfinder governance doctrine
    function isValidDoctrine(d) {
      return d.authority is string && d.authority.size() <= 128
        && d.category is string && d.category.size() <= 128
        && d.status is string && d.status.size() <= 128
        && d.role is string && d.role.size() <= 256
        && d.description is string && d.description.size() <= 4096;
    }

    function isValidCopilotMessage(m) {
      return m.id is string && m.id.size() <= 128
        && m.sender is string && m.sender.size() <= 64
        && m.text is string && m.text.size() <= 16384
        && m.timestamp is string && m.timestamp.size() <= 128
        && m.createdAt is number;
    }

    function isValidCmeCredential(c) {
      return c.id is string && c.id.size() <= 128
        && c.username is string && c.username.size() <= 256
        && c.password is string && c.password.size() <= 512;
    }

    function isValidAssetProfile(a) {
      return a.id is string && a.id.size() <= 128
        && a.name is string && a.name.size() <= 256
        && (a.get('preferredSessions', []) is list)
        && (a.get('failedSetupsCount', 0) is number)
        && (a.get('successfulConfluencesCount', 0) is number)
        && (a.get('diNapoliFibResponseWeight', 0.0) is number)
        && (a.get('macroDrivers', []) is list)
        && (a.get('liquidityHabits', '') is string && a.get('liquidityHabits', '').size() <= 4096);
    }

    function isValidCustodyTimeframeState(s) {
      return s.id is string && s.id.size() <= 128
        && s.assetId is string && s.assetId.size() <= 128
        && s.timeframe is string && (s.timeframe == 'D1' || s.timeframe == 'H4' || s.timeframe == 'M15' || s.timeframe == 'M5')
        && (s.get('role', '') is string && s.get('role', '').size() <= 256)
        && (s.get('authorityWeight', 0.0) is number)
        && (s.get('currentFinding', '') is string && s.get('currentFinding', '').size() <= 4096)
        && (s.get('invalidationLine', 0.0) is number);
    }

    function isValidPatternRegistryEntry(p) {
      return p.id is string && p.id.size() <= 128
        && p.name is string && (
             p.name == 'X-Break Redistribution' || 
             p.name == 'ABCD Paddle' || 
             p.name == '382 Trap' || 
             p.name == '618 Continuation' || 
             p.name == 'Order Block Mitigation' || 
             p.name == 'Vector Candle Trap'
           )
        && p.asset is string && p.asset.size() <= 128
        && p.outcome is string && (p.outcome == 'SUCCESS' || p.outcome == 'FAILURE')
        && (p.get('timeframe', '') is string && p.get('timeframe', '').size() <= 64)
        && (p.get('session', '') is string && p.get('session', '').size() <= 128)
        && (p.get('entryCondition', '') is string && p.get('entryCondition', '').size() <= 1024)
        && (p.get('invalidation', 0.0) is number)
        && (p.get('target', 0.0) is number)
        && (p.get('lesson', '') is string && p.get('lesson', '').size() <= 4096)
        && (p.get('probabilityWeight', 0.0) is number);
    }

    function isValidMacroContextSnapshot(m) {
      return m.id is string && m.id.size() <= 128
        && m.timestamp is string && m.timestamp.size() <= 128
        && (m.get('yieldCurveStatus', '') is string && m.get('yieldCurveStatus', '').size() <= 256)
        && (m.get('dxyTrend', '') is string && m.get('dxyTrend', '').size() <= 128)
        && (m.get('vixValue', 0.0) is number)
        && (m.get('fedPolicyBias', '') is string && m.get('fedPolicyBias', '').size() <= 256)
        && (m.get('newsEventImpact', '') is string && m.get('newsEventImpact', '').size() <= 4096);
    }

    function isValidOutcomeFeedbackItem(f) {
      return f.id is string && f.id.size() <= 128
        && f.patternId is string && f.patternId.size() <= 128
        && f.asset is string && f.asset.size() <= 128
        && f.actualOutcome is string && f.actualOutcome.size() <= 256
        && (f.get('predictedBias', '') is string && f.get('predictedBias', '').size() <= 128)
        && (f.get('deviation', 0.0) is number)
        && (f.get('weightAdjustmentApplied', 0.0) is number)
        && (f.get('unsolicitedNotes', '') is string && f.get('unsolicitedNotes', '').size() <= 4096);
    }

    function isValidOperatorOverride(o) {
      return o.id is string && o.id.size() <= 128
        && o.asset is string && o.asset.size() <= 128
        && o.approvedByOperator is bool
        && (o.get('timeframe', '') is string && o.get('timeframe', '').size() <= 64)
        && (o.get('overrideReason', '') is string && o.get('overrideReason', '').size() <= 4096)
        && (o.get('sealSignature', '') is string && o.get('sealSignature', '').size() <= 512);
    }

    function isValidMarketSnapshot(s) {
      return s.id is string && s.id.size() <= 128
        && s.asset is string && s.asset.size() <= 128
        && s.timestamp is string && s.timestamp.size() <= 128
        && (s.price.get('spot', 0.0) is number || s.price.get('level', 0.0) is number)
        && s.rates.get('realYield', 0.0) is number
        && s.dollar.get('trend', '') is string
        && s.volatility.get('vix', 0.0) is number
        && s.sourceConfidence.get('source', '') is string
        && s.sourceConfidence.get('score', 0) is number;
    }

    // 3. Custody Packets Collection
    match /custody_packets/{packetId} {
      allow read: if true; // Publicly readable for cockpit dashboard visibility
      allow create, update: if isValidId(packetId) && isValidPacket(request.resource.data);
      allow delete: if false; // Immutable audit ledger
    }

    // 4. Dataset Candidates Collection
    match /dataset_candidates/{candidateId} {
      allow read: if true;
      allow create, update: if isValidId(candidateId) && isValidCandidate(request.resource.data);
      allow delete: if false;
    }

    // 5. Validation Reviews Collection
    match /validation_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isValidId(reviewId) && isValidReview(request.resource.data);
      allow delete: if false;
    }

    // 6. Operator Approvals Collection
    match /operator_approvals/{approvalId} {
      allow read: if true;
      allow create, update: if isValidId(approvalId) && isValidApproval(request.resource.data);
      allow delete: if false;
    }

    // 7. Authority Doctrine Collection
    // Loosened for client-paths on purpose (e.g. database seeding) with strict structural schema validation
    match /authority_doctrine/{authorityId} {
      allow read: if true;
      allow create, update: if isValidId(authorityId) && isValidDoctrine(request.resource.data);
      allow delete: if isValidId(authorityId);
    }

    // 8. Copilot Chat Messages Collection
    match /copilot_messages/{messageId} {
      allow read: if true;
      allow create, update: if isValidId(messageId) && isValidCopilotMessage(request.resource.data);
      allow delete: if true;
    }

    // 9. CME Credentials Collection
    match /cme_credentials/{credentialId} {
      allow read: if true;
      allow write: if isValidId(credentialId) && isValidCmeCredential(request.resource.data);
    }

    // 10. Asset Profiles Collection
    match /asset_profiles/{assetId} {
      allow read: if true;
      allow create, update: if isValidId(assetId) && isValidAssetProfile(request.resource.data);
      allow delete: if isValidId(assetId);
    }

    // 11. Custody Timeframe States Collection
    match /custody_timeframe_states/{stateId} {
      allow read: if true;
      allow create, update: if isValidId(stateId) && isValidCustodyTimeframeState(request.resource.data);
      allow delete: if isValidId(stateId);
    }

    // 12. Pattern Registry Collection
    match /pattern_registry/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId) && isValidPatternRegistryEntry(request.resource.data);
      allow delete: if isValidId(entryId);
    }

    // 13. Macro Context Snapshots Collection
    match /macro_context_snapshots/{snapshotId} {
      allow read: if true;
      allow create, update: if isValidId(snapshotId) && isValidMacroContextSnapshot(request.resource.data);
      allow delete: if isValidId(snapshotId);
    }

    // 14. Outcome Feedback Collection
    match /outcome_feedback/{feedbackId} {
      allow read: if true;
      allow create, update: if isValidId(feedbackId) && isValidOutcomeFeedbackItem(request.resource.data);
      allow delete: if isValidId(feedbackId);
    }

    // 15. Operator Overrides Collection
    match /operator_overrides/{overrideId} {
      allow read: if true;
      allow create, update: if isValidId(overrideId) && isValidOperatorOverride(request.resource.data);
      allow delete: if isValidId(overrideId);
    }

    // 16. Market Telemetry Snapshots Collection
    match /market_snapshots/{snapshotId} {
      allow read: if true;
      allow create, update: if isValidId(snapshotId) && isValidMarketSnapshot(request.resource.data);
      allow delete: if isValidId(snapshotId);
    }
  }
}
